# Amina Stays — copy to .env (repo root or backend/.env) and fill in what you need.
# Django, the scheduler and docker compose read it; the website has its own file (frontend/.env.example).
# Everything is optional for a local demo: with no keys set, SMS/voice run in dry-run mode,
# payments are simulated and the Demo Lab (/demo) lets you drive USSD, SMS and voice in the browser.
# For a hackathon or a trial, the free Africa's Talking sandbox is all you need, with no registered business: keep
# DEMO=1 and set AT_USERNAME=sandbox, the sandbox app's AT_API_KEY, AT_USSD_CODE, AT_SMS_NUMBER, AT_WEBHOOK_SECRET,
# AT_DATA_PRODUCT (any name), and a tunnel's address as PUBLIC_URL and FRONTEND_URL. The live-only items below are for
# running a real business.
#
# A live site needs at least: DEBUG=0, DEMO=0, SECRET_KEY, ID_ENCRYPTION_KEY, AMINA_PHONE, https PUBLIC_URL and
# FRONTEND_URL, ALLOWED_HOSTS, AT_USERNAME + AT_API_KEY, AT_SENDER_ID (or AT_SMS_NUMBER), AT_WEBHOOK_SECRET and a card
# provider (Paystack in Kenya). Then `cd backend && uv run python manage.py check --deploy` lists anything still missing.
# Prices below are indicative (Africa's Talking's 2025 rate card, the providers' sites): confirm them before paying.
# The marketplace image reads a few more (SEED_DEMO, WEB_CONCURRENCY...): see marketplace/README.md.

# ---------- Django ----------
DEBUG=1                                   # 0 in production
SECRET_KEY=                               # required when DEBUG=0; keep it stable (changing it logs everyone out)
                                          # generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEMO=1                                    # Demo Lab, on-screen login codes, demo shortcuts. Set 0 in production!
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.ngrok-free.app,.ngrok.app,.trycloudflare.com   # live: add your domain
DATABASE_URL=postgres://amina:amina@localhost:5432/amina   # PostgreSQL 13+; its owner must be able to create btree_gist
LOG_LEVEL=INFO
# SECURE_COOKIES=1                        # secure cookies when DEBUG=0 (default on)
# SECURE_HSTS_SECONDS=0
# CSRF_TRUSTED_ORIGINS=                   # extra origins, comma separated
# CORS_ALLOWED_ORIGINS=

# ---------- URLs ----------
FRONTEND_URL=http://localhost:3000        # where guests open links (trip pages, card checkout); live: https://<your-domain>
                                          # with Africa's Talking keys (sandbox too) use your public address, e.g. FRONTEND_URL=${PUBLIC_URL}:
                                          # AT rejects any SMS that contains a localhost link (HTTP 403)
BACKEND_URL=http://127.0.0.1:8000         # the Django API (the website reads its own copy: frontend/.env.example)
PUBLIC_URL=                               # public HTTPS base Africa's Talking, Paystack/Stripe and Safaricom call back on, e.g. https://abc123.ngrok-free.app
                                          # on a laptop: `ngrok http 3000` (free authtoken from dashboard.ngrok.com)
                                          # or `cloudflared tunnel --url http://localhost:3000` (no account needed)
                                          # for live M-Pesa (DARAJA_ENV=production) it must be your own https domain - Safaricom blocks ngrok

# ---------- The host ----------
AMINA_PHONE=+254700000001                 # Amina's phone: alerts, approvals, digests, "#12 reply" commands (a demo number: set hers)
                                          # on a live server without the demo data, create her host login once (she signs in by SMS code):
                                          # cd backend && DJANGO_SUPERUSER_PHONE=+2547XXXXXXXX uv run python manage.py createsuperuser --noinput
SIMULATOR_GUESTS=                         # comma-separated guest numbers you connect in the Africa's Talking simulator, e.g.
                                          # +254711000001,+254711000002,+254711000003,+254711000004,+254711000005: seed_demo
                                          # (or `manage.py simulator_guests`) makes them real guests, one at each stage of a stay
                                          # (new, arriving, staying, booked with a balance, returning) - README "Five guests"
ID_ENCRYPTION_KEY=                        # Fernet key for guest ID numbers (derived from SECRET_KEY if empty)
                                          # set it before going live and never change it, or stored ID numbers become unreadable
                                          # generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# ---------- Africa's Talking: https://account.africastalking.com ----------
# Sandbox (free, for testing): open the "sandbox" app > Settings > API Key, create a USSD channel and a shortcode there,
# then dial and text them at https://developers.africastalking.com/simulator. Live: create a team and an app, verify the account and
# top up its balance (SMS, USSD and calls are pay-as-you-go). Register the callback URLs from the README
# ("Connecting Africa's Talking"); Host > Channels lists them with your PUBLIC_URL and secret filled in.
AT_USERNAME=sandbox                       # "sandbox" for the simulator, your app username for live
AT_API_KEY=                               # the app's Settings > API Key (shown once); empty = dry run (messages are logged, not sent)
AT_SENDER_ID=                             # approved alphanumeric sender ID; empty = send from AT_SMS_NUMBER
                                          # apply: dashboard > SMS > Sender IDs, with business registration proof and an authorisation letter;
                                          # ~KES 8,700 for Safaricom (14,100 bundled), ~2 working days (Safaricom: Mon/Thu before 12:30)
                                          # with neither, AT's default sender only reaches Airtel numbers in Kenya - login codes won't arrive
AT_SMS_NUMBER=                            # two-way shortcode for "Ask Amina" (incoming SMS callback), shown to guests, e.g. 20880
                                          # live: order a shared shortcode + keyword from AT (order form > invoice > activation)
AT_USSD_CODE=                             # shown to guests, e.g. *384*12345#
                                          # dashboard > USSD > create a channel on a shared code: free setup, then ~KES 10-40k/month
                                          # plus ~KES 1.25-1.5 per session (deposit required)
AT_VOICE_NUMBER=                          # your AT voice number in +E.164, e.g. +254711082000 (Voice has no sandbox)
                                          # dashboard > Voice > buy a number (KYC): ~KES 5,000 setup + 2,000/month + VAT
AT_WHATSAPP_NUMBER=                       # optional WhatsApp channel (preview product): verified Meta Business, ~USD 85 setup + 50/month
AT_WEBHOOK_SECRET=                        # recommended: callbacks then live at /at/<secret>/… (AT doesn't sign webhooks)
                                          # generate: python3 -c "import secrets; print(secrets.token_hex(24))"
AT_DATA_PRODUCT=                          # Mobile Data product name: outage and reward bundles, the optional welcome bundle
                                          # with an API key (sandbox or live) but no name here, no data bundles are sent; in the sandbox
                                          # any name keeps them on for the demo guests, whose airtime and data are always simulated
                                          # Mobile Data and Airtime (rewards, gifts) are off on every AT account until you apply: email
                                          # airtime@africastalking.com a stamped, signed letter on company letterhead + AT's contact form,
                                          # then sign their service agreement. Fund the data wallet: M-Pesa Paybill 525900, account wallet<product code>
AT_PAYMENT_PRODUCT=AminaStays             # only for MPESA_PROVIDER=africastalking (onboarding-gated)
AT_HTTP_TIMEOUT=10
# GUIDE_REGION=Kenya                      # added to local-guide map searches, e.g. "Fort Jesus, Old Town, Kenya" (default: Kenya)
SIM_SWAP_PROVIDER=                        # africastalking | simulate | empty = auto (simulate without an API key; numbers ending 999 = swapped)
                                          # AT Insights is a preview product (~KES 1 per check): if your account doesn't have it, ask AT support;
                                          # a failed check is recorded and door codes still go out

# ---------- Payments ----------
# Cards go through a hosted checkout page, so card numbers never touch this server; with no keys, a simulated card page
# confirms bookings without moving money. In Kenya use Paystack: Stripe doesn't open accounts for Kenyan businesses
# (it sends them to Paystack, its African company).
CARD_PROVIDER=                            # empty = stripe once STRIPE_SECRET_KEY is set (else simulate) | paystack
PAYSTACK_SECRET_KEY=                      # for CARD_PROVIDER=paystack (set both together): dashboard.paystack.com > Settings > API Keys & Webhooks
                                          # sk_test_... works at once; sk_live_... after activation (a starter business needs a national ID and a
                                          # bank or M-Pesa account). Set the webhook URL there to https://<your-site>/api/payments/paystack/webhook
                                          # Paystack's page also offers M-Pesa. Refunds: send them in Paystack, then mark them sent in Host > Payments
STRIPE_SECRET_KEY=                        # Stripe Checkout, for a business in a country Stripe supports: sk_test_... (test cards) or sk_live_...,
                                          # from Stripe > Developers > API keys
STRIPE_WEBHOOK_SECRET=                    # whsec_... of a webhook to https://<your-site>/api/payments/stripe/webhook for the checkout.session.* events
                                          # optional: without it a card payment confirms when the guest returns to the site, or within 2 minutes

# M-Pesa is off until Safaricom's Daraja Go-Live is done: guests pay by card on every channel (USSD/SMS/voice get a link by SMS).
# Daraja keys: developer.safaricom.co.ke > My Apps > create an app (M-Pesa Express) for the consumer key and secret; the sandbox
# uses shortcode 174379 and the test passkey shown in the portal. Live: a business Paybill or Till, then Go-Live in the portal
# (the passkey comes by email); this can take weeks.
MPESA_PROVIDER=off                        # off | simulate (a pretend prompt, for demos) | daraja | africastalking
SIM_PAY_DELAY_SECONDS=6                   # simulated STK push succeeds after N seconds (0 = only via the Demo Lab button)
DARAJA_ENV=sandbox                        # sandbox | production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379                   # 174379 is the sandbox; live = your Paybill (for a Till, the store/HO number)
DARAJA_PASSKEY=                           # the live passkey comes by email after Go-Live
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline  # CustomerPayBillOnline (Paybill) | CustomerBuyGoodsOnline (Till)
DARAJA_PARTY_B=                           # the Till number for CustomerBuyGoodsOnline (empty = DARAJA_SHORTCODE)
DARAJA_CALLBACK_SECRET=                   # path secret shared by the M-Pesa prompt (STK) and Paybill (C2B) callbacks; empty = AT_WEBHOOK_SECRET
                                          # use hex (python -c "import secrets; print(secrets.token_hex(24))"): Safaricom rejects URLs with words like exe, cmd, sql, query
MPESA_SHORTCODE=                          # Paybill shown to guests as the fallback when the STK prompt fails (defaults to DARAJA_SHORTCODE when that's a Paybill; 174379 in DEMO)
                                          # Paybill only: a Till payment carries no account number, so it can't be matched to a booking
                                          # register the Paybill callbacks once with: cd backend && uv run python manage.py register_c2b
                                          # (live URLs must be https on your own domain: Safaricom blocks ngrok and similar tunnels)

# ---------- Smart locks (optional) ----------
# igloohome: an igloohome account, then the API portal (https://web.igloohome.co/api) > API Access; 30-day trial, then ~USD 2
# per lock per month. Caution: igloohome now issues OAuth tokens (from a Client ID + Secret) that expire every 24 hours, while the
# app takes one fixed token below, so real locks need a code change first: once the token expires, guests get a simulated code
# that won't open the lock.
IGLOOHOME_API_BASE=                       # empty = simulated keypad codes
IGLOOHOME_API_KEY=

# ---------- Background jobs ----------
SCHEDULER_INTERVAL_SECONDS=30             # python manage.py run_scheduler
OUTBOX_MODE=thread                        # thread | sync | queue (queue = the scheduler sends)
DB_CONN_MAX_AGE=60
